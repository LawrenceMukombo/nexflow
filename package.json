{
  "name": "omniflow-platform",
  "version": "1.0.0",
  "private": true,
  "description": "OmniFlow — Intelligent Visual Engineering Design & Simulation Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@omniflow/web",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "engineering",
    "simulation",
    "network-design",
    "flow-simulation",
    "graph-modeling"
  ],
  "author": "OmniFlow Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
